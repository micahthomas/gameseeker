{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameseeker",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],

  // Custom entry (rather than "@tanstack/react-start/server-entry") so we can
  // export a `scheduled` handler for cron alongside the Start fetch handler.
  "main": "./src/server.ts",

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gameseeker",
      // Created with: npx wrangler d1 create gameseeker
      // Local D1 is keyed by this id, not by name — the test environment below
      // must keep a different one or the browser suite wipes development data.
      "database_id": "4eb5acce-f174-4b35-95fd-d963b1a0477d",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // Outbound email and SMS. The request path writes notification rows and
  // enqueues; the `queue` export in src/server.ts does the sending, so a host
  // posting a game never waits on a delivery round trip per recipient.
  //
  // Before the first deploy: npx wrangler queues create gameseeker-notifications
  //                          npx wrangler queues create gameseeker-notifications-dlq
  "queues": {
    "producers": [{ "queue": "gameseeker-notifications", "binding": "NOTIFY_QUEUE" }],
    "consumers": [
      {
        "queue": "gameseeker-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // Messages are retried individually, not per batch, so this is three
        // attempts at one address rather than three at twenty.
        "max_retries": 3,
        "dead_letter_queue": "gameseeker-notifications-dlq"
      }
    ]
  },

  "triggers": {
    "crons": [
      // Hourly: game reminders, auto-cancel under-filled games, expire tokens.
      "0 * * * *",
      // Daily 4am UTC (~10pm MDT): mark games complete, purge expired rows.
      "0 4 * * *"
    ]
  },

  "vars": {
    // Public base URL used to build magic-link and claim URLs in messages.
    "APP_URL": "http://localhost:3000",
    // "console" | "resend". Console prints messages to the log (zero setup).
    "MAIL_PROVIDER": "console",
    // "none" | "twilio". Wire up later; see src/server/notify/twilio.ts.
    "SMS_PROVIDER": "none",
    "MAIL_FROM": "GameSeeker <noreply@example.com>",
    "TIMEZONE": "America/Denver"
  }

  ,

  // Browser tests run against this environment (CLOUDFLARE_ENV=test) so they
  // get their own local D1. Without it, the suite's reset step would wipe the
  // players and sessions in your development database on every run.
  //
  // Named environments do not inherit top-level `vars`, so they're repeated.
  "env": {
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gameseeker-test",
          // Must differ from the database_id above. Local D1 storage is keyed
          // by id, not by name, so sharing an id — including sharing the same
          // placeholder — puts both environments in one SQLite file and lets
          // the test suite's reset wipe your development data.
          // This environment is local-only, so the value just has to be unique.
          "database_id": "11111111-1111-4111-8111-111111111111",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      // Named environments inherit nothing, so the queue has to be repeated
      // here too — without it the browser suite boots a Worker whose
      // NOTIFY_QUEUE binding is missing and every notification silently takes
      // the inline fallback path instead of the one production uses.
      "queues": {
        "producers": [{ "queue": "gameseeker-notifications", "binding": "NOTIFY_QUEUE" }],
        "consumers": [
          {
            "queue": "gameseeker-notifications",
            // Tighter than production: a browser test that asserts on a
            // delivered message shouldn't wait five seconds for a batch to
            // close.
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 1
          }
        ]
      },
      "vars": {
        "APP_URL": "http://localhost:3100",
        "MAIL_PROVIDER": "console",
        "SMS_PROVIDER": "none",
        "MAIL_FROM": "GameSeeker <noreply@example.com>",
        "TIMEZONE": "America/Denver"
      }
    }
  }

  // Secrets (set with `npx wrangler secret put <NAME>`, never commit):
  //   SESSION_SECRET   - required. Random 32+ bytes, signs session cookies.
  //   RESEND_API_KEY   - only if MAIL_PROVIDER=resend
  //   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM - only if SMS_PROVIDER=twilio
}
